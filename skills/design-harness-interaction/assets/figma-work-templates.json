{
  "schemaVersion": 1,
  "kit": "design-harness-work-templates",
  "version": "1.5.1",
  "artifactKind": "native-figma-construction-blueprint",
  "namespace": "DH Docs",
  "defaults": {
    "scope": "documentation-only",
    "font": "resolve-from-project-and-available-fonts",
    "colors": {
      "canvas": "#FFFFFF",
      "text": "#242A33",
      "mutedText": "#596579",
      "sceneAccent": "#165DFF",
      "actorSurface": "#BEDAFF",
      "annotationSurface": "#E8F3FF",
      "border": "#D8DEE8"
    },
    "typography": {
      "title": 32,
      "section": 24,
      "subsection": 20,
      "body": 18,
      "caption": 14,
      "code": 16
    },
    "reading": {
      "textColumnWidth": 720,
      "lineHeightPercent": 150,
      "paragraphSpacing": 12,
      "listIndent": 24
    },
    "spacing": {
      "section": 48,
      "column": 32,
      "item": 16,
      "padding": 24
    },
    "screenAspectRatio": "from-source",
    "actorNames": "from-task",
    "stepCount": "from-task"
  },
  "documentPresentation": {
    "appliesTo": [
      "harness-entry",
      "module-overview",
      "resource-spec",
      "template-config",
      "requirement-index",
      "requirement-summary",
      "writeback-delta"
    ],
    "blocks": [
      {
        "role": "title",
        "typography": "title",
        "presentation": "文档主标题；Contract/版本标签使用次要样式。"
      },
      {
        "role": "section",
        "typography": "section",
        "presentation": "章节标题，以字重和段前间距区分层级。"
      },
      {
        "role": "subsection",
        "typography": "subsection",
        "presentation": "章节内的小节，与所属正文保持紧密。"
      },
      {
        "role": "paragraph",
        "typography": "body",
        "presentation": "短段落，字段名适度加粗，定宽自动增高。"
      },
      {
        "role": "list",
        "typography": "body",
        "presentation": "原生列表或项目符号/编号、悬挂缩进；索引可用分组列表。"
      },
      {
        "role": "table",
        "typography": "body",
        "presentation": "表头与对齐列、行高随内容增长；遵循语义 TEXT 的完整读取约束。"
      },
      {
        "role": "diagram",
        "typography": "caption",
        "presentation": "流程、状态与关系用原生图形、方向线和短标签，必要条件就近说明；可见连线不代替原型交互。"
      },
      {
        "role": "code",
        "typography": "code",
        "presentation": "必要的设计 token 或资源标识可用等宽字体，名称与值完整；不用于源码或命令区域。"
      },
      {
        "role": "link",
        "typography": "body",
        "presentation": "有意义的标签；完整 URL 或节点 ID 同时保留在可见正文。"
      },
      {
        "role": "status",
        "typography": "body",
        "presentation": "明确状态文字与克制强调，不仅靠颜色传达。"
      },
      {
        "role": "metadata",
        "typography": "caption",
        "presentation": "设计版本、日期等次要信息；必要的设计来源链接保持可读。"
      }
    ],
    "contractTextNodes": [
      "DH / Entry",
      "DH / Module",
      "DH / Resource",
      "DH / Work Templates"
    ],
    "constraints": [
      "正文用产品行为、设计规则与状态表达；源码信息只保留入口的一条仓库链接，不另建技术附录或隐藏副本。",
      "项目上下文写产品与业务概览；具体页面行为归入布局、组件或场景模块。",
      "在可见原生 TEXT 内按范围设置层级，保留设计内容与原有节点 ID；旧源码定位字段不再必填。",
      "不能将文本蓝图全文同字号平铺；普通说明可用 Auto Layout 分段，语义 TEXT 内优先用富文本与分组列表。",
      "必要的长链接保持完整，视觉换行不改变地址；不以缩小整页字体解决溢出。",
      "项目文档配置优先，默认值仅填空缺；正文回读与整体/局部截图分别检查。",
      "图形与画面对照承载主要表达，短文补必要规则；不为减少文字删除标签、后果、状态或可读取定位。"
    ]
  },
  "primitives": [
    {
      "id": "doc/diagram",
      "nativeType": "FRAME",
      "layout": "FROM_RELATIONSHIPS",
      "usage": "可编辑流程/状态示意图，原生短标签与方向线明确关系；来源不明的业务关系标待核实。"
    },
    {
      "id": "doc/label",
      "nativeType": "COMPONENT",
      "properties": {
        "label": "TEXT",
        "role": "VARIANT"
      },
      "roles": [
        "scene",
        "actor",
        "step",
        "status"
      ],
      "layout": "AUTO_LAYOUT",
      "usage": "场景、参与端、步骤及状态标签；每种角色有文字表达，按需要建立变体。"
    },
    {
      "id": "doc/annotation",
      "nativeType": "COMPONENT",
      "properties": {
        "heading": "TEXT",
        "body": "TEXT"
      },
      "layout": "AUTO_LAYOUT",
      "usage": "画面旁的必要条件、操作后果、反馈或来源短注释；正文随内容增高，不重复图中已清楚的信息。"
    },
    {
      "id": "doc/viewport",
      "nativeType": "FRAME",
      "layout": "SOURCE_ASPECT_RATIO",
      "usage": "放置可编辑产品画面、组件实例或已标记的原稿参考；保留原始设计尺寸与来源。"
    }
  ],
  "templates": [
    {
      "id": "work/scenario-flow",
      "name": "场景流程",
      "nativeType": "FRAME",
      "layout": "AUTO_LAYOUT",
      "uses": [
        "doc/diagram",
        "doc/label",
        "doc/annotation",
        "doc/viewport"
      ],
      "requiredSlots": [
        "task",
        "entryConditions",
        "actors",
        "steps",
        "outcomes",
        "sources"
      ],
      "optionalSlots": [
        "branches",
        "recovery",
        "verification",
        "flowScope",
        "branchOrigin",
        "rejoinOrExit",
        "prototypeEntry",
        "prototypeInteractions",
        "confirmation"
      ],
      "structure": [
        "用户任务与流程骨架，标出当前主流程或分支",
        "前置条件、参与端及阅读顺序",
        "已获准步骤按列、参与端按行：标题 → 实际画面或明确的无操作说明 → 交互注释；待生成项仅登记",
        "分支触发、恢复路径、汇入或结束；设计原型附真实起点与交互连接",
        "设计依据、实现状态与必要的待验证事项"
      ],
      "repetition": {
        "actors": "one-or-more",
        "steps": "one-or-more"
      },
      "constraints": [
        "同列保持同一步骤的语义；使用横向 Auto Layout 组织步骤、纵向组织参与端。",
        "标题和说明随内容增高；跨端比较时对齐对应区域，避免长文打乱步骤关系。",
        "复杂分支另行展开并明确起止关系，不把分支画面排成必经步骤。",
        "交互先确认流程和关键草图，再逐页生成主流程；各页确认后串联走查并取得整体验收，再补分支和状态。",
        "每轮仅制作获准页面或单页的一种状态，展示后等待下一项放行；蓝图不授权铺满步骤、状态或空白画板。",
        "原型入口与连接来自实际资产；未生成目标的连接明确待补，不预建目标或假造已连通；配置、实际点击和产品运行分别表达。"
      ]
    },
    {
      "id": "work/proposal-comparison",
      "name": "代表方案对比",
      "nativeType": "FRAME",
      "layout": "AUTO_LAYOUT",
      "uses": [
        "doc/label",
        "doc/annotation",
        "doc/viewport"
      ],
      "requiredSlots": [
        "sharedTask",
        "comparisonAxes",
        "proposals",
        "evidence",
        "selectionState"
      ],
      "optionalSlots": [
        "recommendation",
        "tradeoffs",
        "openQuestions",
        "selectionRationale",
        "integrationScope",
        "integratedPreview",
        "integratedConfirmation"
      ],
      "structure": [
        "共同任务、约束、代表画面范围与比较维度",
        "逐项补入候选：主张 → 已获准生成的实际片段/代表页 → 同一维度的收益和代价；未生成候选仅登记",
        "证据、推荐理由与待核实事项",
        "真实选择及理由，或尚未选择",
        "需要整合时呈现主方向、融合范围、整合代表稿与该版本的确认"
      ],
      "repetition": {
        "proposals": "from-confirmed-scope",
        "comparisonAxes": "shared-across-proposals"
      },
      "constraints": [
        "方案列宽和信息层级一致，允许按内容增长；超宽时分组，保留共同内容、状态、尺寸与评价维度。",
        "交互阶段默认一套主方案，关键分歧才做局部备选；选定后并回。",
        "视觉先访谈目标，计划 2–3 套代表方案；一次只生成一套候选的一个代表页，展示并等待下一项放行，齐备后再比较选主方向；小修改同样适用。",
        "候选制作验收不等于最终选定；整合代表稿逐页确认后，完整展开仍逐页、逐状态放行，不批量生成或预复制全套。",
        "完整多套方案须有用户明确要求；模板不自动确定优胜方案或推定用户批准。"
      ]
    },
    {
      "id": "work/resource-spec",
      "name": "规范资源",
      "nativeType": "FRAME",
      "layout": "AUTO_LAYOUT",
      "uses": [
        "doc/label",
        "doc/annotation"
      ],
      "requiredSlots": [
        "resourceId",
        "purposeAndScope",
        "assetOrRule",
        "usage",
        "sources",
        "designState",
        "implementationState"
      ],
      "optionalSlots": [
        "properties",
        "states",
        "dependencies",
        "confirmation",
        "supersedes",
        "verification",
        "sourceLibrary",
        "assetType",
        "usageRights"
      ],
      "structure": [
        "标题、稳定资源 ID 与适用范围",
        "真实资产、实例或可执行规则",
        "使用条件、必要属性与状态",
        "设计依据、依赖、设计状态、实现状态及必要的验证限制",
        "实际确认记录与变更关系"
      ],
      "repetition": {
        "examples": "as-needed"
      },
      "constraints": [
        "资源旁保留可读取的原生 TEXT DH / Resource，使用资源说明蓝图的字段。",
        "说明卡自身是文档 Frame；只有内部真实组件才记录为产品组件。",
        "确认记录来自实际对话；缺少事实时标为未核实，不能由模板默认生成已确认状态。"
      ]
    }
  ]
}
