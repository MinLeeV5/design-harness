{
  "name": "design-harness",
  "version": "0.2.0",
  "private": true,
  "description": "Design Harness 插件的开发、校验、测试与打包工具",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run validate && npm test",
    "package": "node scripts/package-plugin.js",
    "demo": "node scripts/demo.js",
    "test:browser": "node scripts/browser-smoke.js && node scripts/navigation-smoke.js && node scripts/agent-smoke.js && node scripts/roles-smoke.js",
    "workbench": "node workbench/cli.mjs",
    "typecheck": "node workbench/cli.mjs typecheck"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "^0.8.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
